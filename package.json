{
  "name": "dailyops",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/validate-build-env.mjs && nuxt build",
    "check:content": "node scripts/validate-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --fail-on error",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > app/types/database.generated.ts",
    "dev": "nuxt dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "node scripts/validate-build-env.mjs && nuxt generate",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "quality": "npm run format:check && npm run lint && npm run check:content && npm run typecheck && npm run build && npm run check:links",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/content": "^3.15.2",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/robots": "^6.1.3",
    "@nuxtjs/sitemap": "^8.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "@vueuse/nuxt": "^14.4.0",
    "better-sqlite3": "^12.11.1",
    "nuxt": "^4.5.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@emnapi/core": "^2.0.0-alpha.3",
    "@emnapi/runtime": "^2.0.0-alpha.3",
    "@nuxt/eslint": "^1.16.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "supabase": "^2.114.0",
    "vue-tsc": "^3.3.8"
  }
}
